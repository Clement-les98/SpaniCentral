<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>SpaniCentral | Jobs, Learnerships, Internships & Graduate Programmes</title>


        <link rel="icon" type="image/png" href="/uploads/logo.png">
<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<meta
    name="description"
    content="Find internships, learnerships, graduate programmes, entry-level jobs and general jobs across South Africa on SpaniCentral.">

<meta
    name="keywords"
    content="Jobs South Africa, Learnerships, Graduate Programmes, Internships, Entry Level Jobs, Careers, Employment">

<meta
    name="author"
    content="SpaniCentral">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>

     <%- include("partials/navbar") %>

  <!-- HERO SECTION -->
  <section class="hero">
    <h1>Your Central Hub for Jobs in South Africa</h1>
    <p>Start your career today</p>

    <input type="text" id="search" placeholder="Search by location or title">
    <button onclick="searchJobs()">Search</button>
  </section>

  <section class="categories">

  <div
    class="category-card"
    onclick="window.location.href='/jobs?type=Internship'">

    <h3>Internships</h3>

  </div>

  <div
    class="category-card"
    onclick="window.location.href='/jobs?type=Learnership'">

    <h3>Learnerships</h3>

  </div>

  <div
    class="category-card"
     onclick="window.location.href='/jobs?type=Graduate Programme'">

    <h3>Graduate Programmes</h3>

  </div>

  <div
    class="category-card"
   onclick="window.location.href='/jobs?type=Entry-Level-Job'">

    <h3>Entry-Level Jobs</h3>

  </div>
  
   <div
    class="category-card"
   onclick="window.location.href='/jobs?type=Job'">

    <h3> Jobs</h3>

  </div>


</section>

   <%- include("partials/footer") %>
  <script src="/js/index.js"></script>

</body>
</html>